# Demo: leave DEMO_MODE=true and run on localhost. The demo page and lead API have no login.
DEMO_MODE=true

# Required when DEMO_MODE=false: protects the lead API with HTTP basic auth (12+ characters).
ADMIN_PASSWORD=

# With a key, Claude qualifies leads; without one, fixed keyword rules do.
# LEAD_EFFORT: low is enough for qualification; raise it only if the eval shows a gain.
ANTHROPIC_API_KEY=
LEAD_MODEL=claude-opus-5-5
LEAD_EFFORT=low

# With a HubSpot service key, leads sync to HubSpot; without one, an in-memory fake CRM is used.
# Create it under Development > Keys > Service keys with these scopes:
# crm.objects.contacts.read/write, crm.objects.deals.read/write, crm.schemas.contacts.read/write
HUBSPOT_TOKEN=

# Sending approved replies. Without SMTP_HOST, approved replies are recorded in the outbox and
# clearly marked "not emailed". For local testing, point this at Mailpit (see README).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
REPLY_TO=

# Owner alerts (strong lead waiting, lead needs attention). A Slack incoming webhook URL, https only.
# Without it, alerts go to the log.
ALERT_WEBHOOK_URL=
# Used for links in alerts.
PUBLIC_URL=http://127.0.0.1:8020

DATABASE_PATH=leads.db
CRITERIA_PATH=criteria.yaml
