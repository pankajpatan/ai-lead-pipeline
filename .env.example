# Demo: leave DEMO_MODE=true and run on localhost. The demo page and lead API have no login.
DEMO_MODE=true

# Required when DEMO_MODE=false: protects the lead API with HTTP basic auth (12+ characters).
ADMIN_PASSWORD=

# With a key, Claude qualifies leads; without one, fixed keyword rules do.
# LEAD_EFFORT: low is enough for qualification; raise it only if the eval shows a gain.
ANTHROPIC_API_KEY=
LEAD_MODEL=claude-opus-5-5
LEAD_EFFORT=low

DATABASE_PATH=leads.db
CRITERIA_PATH=criteria.yaml
